# Domains (DNS A records must point to this server's IP before the first start; Caddy then issues HTTPS certificates).
APP_DOMAIN=meneuygun.example.com
DEMO_DOMAIN=demo.meneuygun.example.com

# 32+ random characters: openssl rand -base64 48
SECRET=

# Login codes: either real e-mail (SMTP) or show the code on screen for demos.
DEMO_SHOW_CODES=true
# SMTP_URL=smtps://user:pass@smtp.hostinger.com:465
# MAIL_FROM=MƏNƏ UYĞUN <no-reply@meneuygun.example.com>

# Voice assistant (free: Groq, https://console.groq.com/keys)
STT_MODE=server
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_CHAT_MODEL=llama-3.3-70b-versatile
AI_STT_MODEL=whisper-large-v3
AI_DAILY_LIMIT=60

# Partner client ids shown as "verified" on the consent screen (comma separated).
VERIFIED_CLIENT_IDS=
