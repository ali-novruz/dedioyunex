# Public URL users see (Vercel project "dedio" rewrites everything to BACKEND_DOMAIN).
APP_URL=https://dedio.vercel.app
# Host names served by Traefik on the VPS (sslip.io resolves to the IP inside the name; no DNS setup needed).
BACKEND_DOMAIN=dedio.89-116-236-208.sslip.io
DEMO_DOMAIN=demo.89-116-236-208.sslip.io

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI)
DATABASE_URL=
DATABASE_SSL=require

# 32+ random characters: openssl rand -base64 48
SECRET=

# Login codes: real e-mail via SMTP, or show codes on screen ONLY for this demo domain (never DEMO_SHOW_CODES=true on a public server).
DEMO_EMAIL_DOMAIN=demo.az
# SMTP_URL=smtps://user:pass@smtp.hostinger.com:465
# MAIL_FROM=MƏNƏ UYĞUN <no-reply@example.com>

# Voice assistant (free: Groq, https://console.groq.com/keys)
STT_MODE=auto
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen/qwen3.8-27b
# Used when the main model is busy or returns a broken answer; every use is logged.
AI_CHAT_MODEL_BACKUP=openai/gpt-oss-120b
AI_STT_MODEL=whisper-large-v3
AI_DAILY_LIMIT=60

# Real Azerbaijani voice (Azure Speech, free tier F0). Without it a Turkish browser voice is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Partner client ids shown as "verified" on the consent screen (comma separated).
VERIFIED_CLIENT_IDS=
