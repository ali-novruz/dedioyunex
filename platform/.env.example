# Local development values. Production values go in deploy/.env (not committed).
APP_URL=http://localhost:3000
# Postgres (Supabase in production). Local: docker run -p 5433:5432 -e POSTGRES_PASSWORD=devpass -e POSTGRES_DB=dedio postgres:16-alpine
DATABASE_URL=postgres://postgres:devpass@localhost:5433/dedio
DATABASE_SSL=disable
# Connections per server instance; use 1 on serverless hosting.
DATABASE_POOL_MAX=8
SECRET=
DEMO_PARTNER_ORIGIN=http://localhost:4000
# Show login codes on screen instead of e-mailing them (demo only).
DEMO_SHOW_CODES=true
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Cizzy <no-reply@example.com>"
# Speech-to-text: "server" (Whisper via AI_* below) or "browser" (Web Speech API, Chrome/Edge/Safari).
STT_MODE=auto
# Any OpenAI-compatible API. Free option: Groq (https://console.groq.com/keys).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen/qwen3.8-27b
# Used when the main model is busy or returns a broken answer; every use is logged.
AI_CHAT_MODEL_BACKUP=openai/gpt-oss-120b
AI_STT_MODEL=whisper-large-v3

# Real Azerbaijani voice (Azure Speech, free tier F0). Without it a Turkish browser voice is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
